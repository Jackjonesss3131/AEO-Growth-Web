---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_URL } from '../consts';
import { DEFAULT_OG_IMAGE } from '../og-image';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, ogImage } = Astro.props;

// Social image: ogImage from frontmatter → heroImage → site default.
const socialImage = ogImage ?? heroImage ?? DEFAULT_OG_IMAGE;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;

const schema = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description,
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate ?? pubDate).toISOString(),
	author: { '@id': `${SITE_URL}/#gerald` },
	publisher: { '@id': `${SITE_URL}/#business` },
	isPartOf: { '@id': `${SITE_URL}/#website` },
	mainEntityOfPage: canonicalURL,
	url: canonicalURL,
	image: new URL(socialImage.src, Astro.site).href,
	inLanguage: 'en',
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={socialImage} schema={schema} />
	</head>
	<body>
		<Header />

		<main>
			<article class="prose">
				<p class="post-date"><FormattedDate date={pubDate} /></p>
				<h1>{title}</h1>
				{updatedDate && (
					<p class="post-updated">Updated <FormattedDate date={updatedDate} /></p>
				)}

				{heroImage && (
					<div class="hero-image">
						<Image width={1020} height={510} src={heroImage} alt="" />
					</div>
				)}

				<slot />
			</article>
		</main>

		<Footer />
	</body>
</html>
