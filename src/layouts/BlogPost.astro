---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_URL, BLOG_CATEGORIES } from '../consts';
import { DEFAULT_OG_IMAGE } from '../og-image';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, ogImage, category } = Astro.props;
const topic = BLOG_CATEGORIES.find((c) => c.slug === category);

// Social image: ogImage from frontmatter → heroImage → site default.
const socialImage = ogImage ?? heroImage ?? DEFAULT_OG_IMAGE;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;

const schema = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description,
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate ?? pubDate).toISOString(),
	author: { '@id': `${SITE_URL}/#gerald` },
	publisher: { '@id': `${SITE_URL}/#business` },
	isPartOf: { '@id': `${SITE_URL}/#website` },
	mainEntityOfPage: canonicalURL,
	url: canonicalURL,
	image: new URL(socialImage.src, Astro.site).href,
	inLanguage: 'en',
	...(topic ? { articleSection: topic.name } : {}),
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={socialImage} schema={schema} />
	</head>
	<body>
		<Header />

		<main>
			<article class="prose">
				<p class="post-date">
					{topic && (<><a class="post-topic" href={`/blog/#${topic.slug}`}>{topic.name}</a> · </>)}
					<FormattedDate date={pubDate} />
				</p>
				<h1>{title}</h1>
				{updatedDate && (
					<p class="post-updated">Updated <FormattedDate date={updatedDate} /></p>
				)}

				{heroImage && (
					<div class="hero-image">
						<Image width={1020} height={510} src={heroImage} alt="" />
					</div>
				)}

				<slot />
			</article>
		</main>

		<Footer />
		<style>
			.post-topic { color: var(--accent-ink); text-decoration: none; font-weight: 600; }
			.post-topic:hover { text-decoration: underline; text-underline-offset: 2px; }
		</style>
	</body>
</html>
