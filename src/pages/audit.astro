---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import {
	CALENDLY_URL,
	SITE_URL,
	AUDIT_PRICE,
	AUDIT_PRICE_VALUE,
	AUDIT_TITLE,
	AUDIT_DESCRIPTION,
	MONTHLY_PRICE,
	FREE_CHECK_NAME,
	FREE_CHECK_SCOPE,
} from '../consts';

export const prerender = true;

// What the buyer gets. Single source of truth for the page body and the Offer schema.
const includes = [
	"25 buyer questions, run across ChatGPT, Perplexity, Gemini and Google's AI results",
	'Compared against 3 named competitors',
	'Every cited source mapped, with the exact URLs',
	'A complete audience map: where your buyers ask, which engine answers, and which sources decide it',
	'Crawler access and entity consistency checked',
	'A prioritized fix list, ranked by impact',
	'A 30-minute walkthrough call',
];

// Illustrative audience map. Fictional company, fictional numbers — never present as a client result.
const mapIntents = [
	{ label: '"Best … for …"', n: 9 },
	{ label: '"X vs Y"', n: 7 },
	{ label: '"Alternatives to …"', n: 5 },
	{ label: '"Does it integrate with …"', n: 4 },
];

const mapEngines = [
	{ name: 'ChatGPT', appeared: 6, recommended: 2 },
	{ name: 'Perplexity', appeared: 11, recommended: 5 },
	{ name: 'Gemini', appeared: 4, recommended: 1 },
	{ name: "Google's AI results", appeared: 8, recommended: 3 },
];

// status: 'you' = you are cited and described correctly, 'wrong' = you are cited but misdescribed,
// 'them' = only competitors are cited, 'none' = nobody owns it yet.
const mapSources = [
	{ name: 'Review platforms', share: 31, status: 'wrong', note: 'Listed, but under a category you left in 2024' },
	{ name: 'Reddit & Slack communities', share: 22, status: 'them', note: 'Competitor A named in 14 threads, you in 0' },
	{ name: 'Comparison articles', share: 19, status: 'them', note: '6 of 8 written by Competitor B' },
	{ name: 'Your own site', share: 12, status: 'you', note: 'Cited for pricing, never for use cases' },
	{ name: 'YouTube walkthroughs', share: 9, status: 'none', note: 'No one owns this yet — open ground' },
	{ name: 'Integration marketplaces', share: 7, status: 'wrong', note: 'Two listings, two different descriptions' },
];

const statusLabel = {
	you: 'You, described correctly',
	wrong: 'You, but misdescribed',
	them: 'Competitors only',
	none: 'Nobody yet',
} as const;

const schema = [
	{
		'@context': 'https://schema.org',
		'@type': 'Service',
		'@id': `${SITE_URL}/audit#service`,
		name: 'AEO audit for B2B SaaS',
		serviceType: 'Answer engine optimization (AEO) audit',
		description: AUDIT_DESCRIPTION,
		url: `${SITE_URL}/audit`,
		provider: { '@id': `${SITE_URL}/#business` },
		areaServed: 'Worldwide',
		audience: { '@type': 'BusinessAudience', name: 'B2B SaaS companies' },
		offers: {
			'@type': 'Offer',
			name: 'The audit',
			description: includes.join('. ') + '.',
			price: AUDIT_PRICE_VALUE,
			priceCurrency: 'USD',
			url: `${SITE_URL}/audit`,
			availability: 'https://schema.org/LimitedAvailability',
		},
	},
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		'@id': `${SITE_URL}/audit#faq`,
		mainEntity: [
			{
				'@type': 'Question',
				name: 'How much does the AEO audit cost?',
				acceptedAnswer: {
					'@type': 'Answer',
					text: `${AUDIT_PRICE}, one time. It is credited in full toward your first month if you continue with ongoing work at ${MONTHLY_PRICE} a month.`,
				},
			},
			{
				'@type': 'Question',
				name: 'How long does the audit take?',
				acceptedAnswer: {
					'@type': 'Answer',
					text: 'Five business days from the point I have your domain and what you sell.',
				},
			},
			{
				'@type': 'Question',
				name: 'Do I keep the findings if I do not hire you?',
				acceptedAnswer: {
					'@type': 'Answer',
					text: 'Yes. The deliverable is yours either way, including the right to act on it yourself or hand it to another vendor.',
				},
			},
			{
				'@type': 'Question',
				name: 'What do you need from me?',
				acceptedAnswer: {
					'@type': 'Answer',
					text: 'Your domain, what you sell, and who you sell it to. No access, no onboarding form.',
				},
			},
		],
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={AUDIT_TITLE} description={AUDIT_DESCRIPTION} schema={schema} />
	</head>
	<body>
		<Header />

		<main>
			<article class="prose">
				<p class="eyebrow">The audit</p>
				<h1>AEO audit for B2B SaaS — {AUDIT_PRICE}</h1>

				<p class="lead">
					One fixed-price diagnosis of what ChatGPT, Perplexity, Gemini and Google's AI results say
					about your company, who they recommend instead, and where every one of those answers came
					from.
				</p>

				<p>
					Most companies in this category start by buying a monitoring dashboard or a retainer. Both
					assume you already know what is broken. This is the step before that: it tells you which of
					the four failure layers is actually costing you the answer, so whatever you do next is
					scoped from findings instead of guesses.
				</p>

				<h2>The audit — {AUDIT_PRICE}, one time</h2>

				<ul>
					{includes.map((i) => <li>{i}</li>)}
				</ul>

				<p>
					Delivered in five business days. Credited in full toward your first month if you continue.
				</p>

				<p>
					I run five a month. Each one is manual work on a real domain, so that's the honest limit.
				</p>

				<div class="prose-cta">
					<a href={CALENDLY_URL} target="_blank" rel="noopener" class="btn-primary">Book the audit</a>
					<a href="/positioning-check/" class="btn-ghost">Check your positioning first</a>
				</div>

			</article>

			<section class="amap" aria-labelledby="amap-title">
				<div class="amap-head">
					<p class="eyebrow">What the audience map looks like</p>
					<h2 id="amap-title">Where your buyers are, and who they hear about</h2>
					<p>
						The centrepiece of the audit. One diagram that follows your buyer from the question they
						type, to the engine that answers, to the sources that engine trusted — and marks, at every
						step, whether you were there.
					</p>
					<p class="amap-disclaimer">
						Illustrative example. The company, competitors and numbers below are fictional.
					</p>
				</div>

				<figure class="amap-fig">
					<div class="amap-legend" aria-label="Legend">
						{Object.entries(statusLabel).map(([k, v]) => (
							<span class="amap-key"><i class={`dot dot-${k}`}></i>{v}</span>
						))}
					</div>

					<div class="amap-tier">
						<p class="amap-step"><span>1</span> Where the question starts</p>
						<div class="amap-intents">
							{mapIntents.map((q) => (
								<div class="amap-intent">
									<p class="amap-intent-n">{q.n}</p>
									<p class="amap-intent-l">{q.label}</p>
								</div>
							))}
						</div>
						<p class="amap-caption">25 buyer questions, grouped by intent.</p>
					</div>

					<div class="amap-flow" aria-hidden="true"></div>

					<div class="amap-tier">
						<p class="amap-step"><span>2</span> Which engine answers</p>
						<div class="amap-engines">
							{mapEngines.map((e) => (
								<div class="amap-engine">
									<p class="amap-engine-name">{e.name}</p>
									<div class="amap-bar" role="img" aria-label={`Appeared in ${e.appeared} of 25 answers, recommended in ${e.recommended}`}>
										<span class="amap-bar-seen" style={`width:${(e.appeared / 25) * 100}%`}></span>
										<span class="amap-bar-rec" style={`width:${(e.recommended / 25) * 100}%`}></span>
									</div>
									<p class="amap-engine-stat">
										<strong>{e.appeared}/25</strong> appeared · <strong>{e.recommended}</strong> recommended
									</p>
								</div>
							))}
						</div>
						<p class="amap-caption">
							<i class="sw sw-seen"></i> mentioned &nbsp; <i class="sw sw-rec"></i> actually recommended
						</p>
					</div>

					<div class="amap-flow" aria-hidden="true"></div>

					<div class="amap-tier">
						<p class="amap-step"><span>3</span> Where the engine got the answer</p>
						<ul class="amap-sources">
							{mapSources.map((s) => (
								<li class={`amap-source amap-${s.status}`}>
									<div class="amap-source-top">
										<p class="amap-source-name"><i class={`dot dot-${s.status}`}></i>{s.name}</p>
										<p class="amap-source-share">{s.share}%<span> of citations</span></p>
									</div>
									<div class="amap-share"><span style={`width:${s.share * 3}%`}></span></div>
									<p class="amap-source-note">{s.note}</p>
								</li>
							))}
						</ul>
						<p class="amap-caption">Every source behind these shares comes with its exact URL in the audit.</p>
					</div>

					<div class="amap-flow" aria-hidden="true"></div>

					<div class="amap-tier amap-verdict">
						<p class="amap-step"><span>4</span> What the map says to fix first</p>
						<ol>
							<li><strong>Review platforms.</strong> The biggest single source, and it files you in the wrong category. Correcting it changes every engine at once.</li>
							<li><strong>Communities.</strong> 22% of citations, zero presence. This is where Competitor A is winning, not on its own site.</li>
							<li><strong>YouTube.</strong> Nobody owns it yet. The cheapest ground to take before someone else does.</li>
						</ol>
					</div>
				</figure>
			</section>

			<article class="prose prose-cont">
				<h2>What you get back</h2>

				<p>
					A document short enough to read in one sitting, plus the call to walk through it. Not a
					visibility score — the specific things that decide whether a buyer hears your name.
				</p>

				<h3>The audience map</h3>
				<p>
					The diagram above, built on your domain: which questions your buyers ask, which engine each
					one goes to, which sources those engines trust, and where you are present, absent or
					misdescribed along the way. It is the one page that shows where your audience actually gets
					its answer — and therefore where the work goes.
				</p>

				<h3>The 25 questions, and what each engine answered</h3>
				<p>
					Your buyers' real decision questions, with their constraints attached, not generic category
					prompts. Recorded per engine, because the engines disagree with each other far more often
					than a single blended number lets on.
				</p>

				<h3>Who appeared in your place</h3>
				<p>
					Measured against 3 competitors you name. Often the companies winning those answers are not
					the ones on your battlecards — that gap is usually the most useful page of the document.
				</p>

				<h3>Every cited source, with the exact URLs</h3>
				<p>
					The pages the engines actually drew from, including the third-party profiles, directories
					and old articles describing you in terms you left behind. You can open each one.
				</p>

				<h3>Crawler access and entity consistency</h3>
				<p>
					Whether AI crawlers can read your pages at all, and whether your title, meta description,
					H1, schema and llms.txt tell the same story about what your company is. Internal
					disagreement is cheap to fix and a surprising number of cases end there.
				</p>

				<h3>A prioritized fix list, ranked by impact</h3>
				<p>
					What to change, in what order, and what each item is expected to move. Yours to keep either
					way — act on it internally, or take it to another vendor.
				</p>

				<h2>Timeline</h2>

				<table>
					<thead>
						<tr><th>Step</th><th>What happens</th></tr>
					</thead>
					<tbody>
						<tr>
							<td><strong>Day 0</strong></td>
							<td>You send your domain, what you sell, and 3 competitors. Nothing else — no access, no onboarding form.</td>
						</tr>
						<tr>
							<td><strong>Days 1–5</strong></td>
							<td>I run the 25 questions across all four engines, map every cited source, and check crawler access and entity consistency.</td>
						</tr>
						<tr>
							<td><strong>Day 5</strong></td>
							<td>The document lands, and we book the 30-minute walkthrough call.</td>
						</tr>
					</tbody>
				</table>

				<h2>Before you pay anything</h2>

				<p>
					Two tools on this site run on your own domain with no signup: a
					<a href="/ai-crawler-check/">crawler check</a> and a
					<a href="/positioning-check/">positioning check</a>. If both come back clean, you may not
					need the audit at all, and I would rather you found that out for free.
				</p>

				<p>
					There is also a free {FREE_CHECK_NAME} before any call — {FREE_CHECK_SCOPE}. It is a quick
					read, deliberately not the audit.
				</p>

				<h2>Common questions</h2>

				<h3>What happens after the audit?</h3>
				<p>
					Nothing you have not asked for. If you want the work done, ongoing engagements are
					{MONTHLY_PRICE} a month with no contract, and the {AUDIT_PRICE} is credited in full toward
					your first month. If you would rather implement internally, the fix list is written to be
					handed to your own team. Full terms are on the <a href="/services/">services page</a>.
				</p>

				<h3>Is this just a report?</h3>
				<p>
					It is a diagnosis with the evidence attached. Every claim in it points at a specific engine
					answer or a specific URL, so you can verify it rather than take my word for it.
				</p>

				<h3>How is this different from an AI visibility tool?</h3>
				<p>
					A tool monitors and tells you a number changed. This tells you why, and which page to
					change. If your positioning is already clean and you have a team that can act on findings,
					a tool may be enough on its own.
				</p>

				<h3>Why only five a month?</h3>
				<p>
					Every one is run by hand on a real domain. Five is what I can do without the quality
					dropping, so that is the published limit rather than a scarcity tactic.
				</p>
			</article>

			<section class="close-cta">
				<h2>Start with the diagnosis.</h2>
				<p>
					{AUDIT_PRICE}, five business days, credited toward your first month if you continue. Five a
					month.
				</p>
				<div class="hero-cta">
					<a href={CALENDLY_URL} target="_blank" rel="noopener" class="btn-primary">Book the audit</a>
					<a href="/services/" class="btn-ghost">See the full engagement</a>
				</div>
			</section>
		</main>

		<Footer />

		<style>
			.prose-cont { padding-top: 1rem; }

			.amap {
				--you: #1f5f4f;
				--wrong: #b7791f;
				--them: #b4463c;
				--none: #aeb4bd;
				margin: 1.5rem 0 1rem;
				padding: 3rem 2.25rem;
				background: var(--sand);
				border: 1px solid var(--line);
				border-radius: 18px;
			}
			.amap-head { max-width: var(--read); margin-bottom: 2rem; }
			.amap-head h2 { margin: .4rem 0 .8rem; font-size: 1.6rem; letter-spacing: -.02em; color: var(--ink); line-height: 1.2; }
			.amap-head p { margin: 0 0 .8rem; line-height: 1.65; }
			.amap-disclaimer { font-size: .85rem; color: var(--muted); font-style: italic; }

			.amap-fig { margin: 0; }

			.amap-legend { display: flex; flex-wrap: wrap; gap: .5rem 1.25rem; margin-bottom: 1.5rem; font-size: .85rem; color: var(--muted); }
			.amap-key { display: inline-flex; align-items: center; gap: .45rem; }
			.dot { display: inline-block; width: .7rem; height: .7rem; border-radius: 50%; flex: none; }
			.dot-you { background: var(--you); }
			.dot-wrong { background: var(--wrong); }
			.dot-them { background: var(--them); }
			.dot-none { background: transparent; border: 2px dashed var(--none); }

			.amap-tier { background: var(--paper); border: 1px solid var(--line); border-radius: 14px; padding: 1.4rem 1.5rem; }
			.amap-step { margin: 0 0 1rem; font-size: .8rem; text-transform: uppercase; letter-spacing: .07em; color: var(--muted); display: flex; align-items: center; gap: .6rem; font-weight: 600; }
			.amap-step span { display: inline-grid; place-items: center; width: 1.5rem; height: 1.5rem; border-radius: 50%; background: var(--ink); color: var(--paper); font-size: .75rem; letter-spacing: 0; }
			.amap-caption { margin: .9rem 0 0; font-size: .82rem; color: var(--muted); }

			.amap-flow { width: 2px; height: 1.6rem; margin: 0 auto; background: repeating-linear-gradient(to bottom, var(--line-strong) 0 4px, transparent 4px 8px); position: relative; }
			.amap-flow::after { content: ''; position: absolute; bottom: -3px; left: 50%; transform: translateX(-50%); border: 5px solid transparent; border-top-color: var(--line-strong); }

			.amap-intents { display: grid; grid-template-columns: repeat(4, 1fr); gap: .75rem; }
			.amap-intent { border: 1px solid var(--line); border-radius: 10px; padding: .85rem .9rem; }
			.amap-intent-n { margin: 0; font-size: 1.6rem; font-weight: 700; color: var(--ink); line-height: 1; }
			.amap-intent-l { margin: .4rem 0 0; font-size: .85rem; font-family: var(--mono); color: var(--body); }

			.amap-engines { display: grid; grid-template-columns: repeat(4, 1fr); gap: .75rem; }
			.amap-engine { border: 1px solid var(--line); border-radius: 10px; padding: .85rem .9rem; }
			.amap-engine-name { margin: 0 0 .6rem; font-weight: 600; color: var(--ink); font-size: .95rem; }
			.amap-engine-stat { margin: .55rem 0 0; font-size: .8rem; color: var(--muted); }
			.amap-engine-stat strong { color: var(--ink); }
			.amap-bar { position: relative; height: 8px; background: var(--line); border-radius: 4px; overflow: hidden; }
			.amap-bar span { position: absolute; left: 0; top: 0; bottom: 0; border-radius: 4px; }
			.amap-bar-seen { background: #a9c6bd; }
			.amap-bar-rec { background: var(--you); }
			.sw { display: inline-block; width: .8rem; height: .5rem; border-radius: 2px; vertical-align: middle; margin-right: .25rem; }
			.sw-seen { background: #a9c6bd; }
			.sw-rec { background: var(--you); }

			.amap-sources { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: .75rem; }
			.amap-source { border: 1px solid var(--line); border-left: 4px solid var(--none); border-radius: 10px; padding: .85rem 1rem; }
			.amap-you { border-left-color: var(--you); }
			.amap-wrong { border-left-color: var(--wrong); }
			.amap-them { border-left-color: var(--them); }
			.amap-none { border-left-style: dashed; }
			.amap-source-top { display: flex; justify-content: space-between; align-items: baseline; gap: .75rem; }
			.amap-source-name { margin: 0; font-weight: 600; color: var(--ink); font-size: .95rem; display: flex; align-items: center; gap: .5rem; }
			.amap-source-share { margin: 0; font-weight: 700; color: var(--ink); white-space: nowrap; }
			.amap-source-share span { font-weight: 400; font-size: .78rem; color: var(--muted); }
			.amap-share { height: 6px; background: var(--line); border-radius: 3px; margin: .55rem 0; overflow: hidden; }
			.amap-share span { display: block; height: 100%; background: var(--ink); opacity: .55; border-radius: 3px; }
			.amap-source-note { margin: 0; font-size: .85rem; color: var(--body); line-height: 1.5; }

			.amap-verdict { border-color: var(--accent); background: var(--accent-soft); }
			.amap-verdict ol { margin: 0; padding-left: 1.2rem; }
			.amap-verdict li { margin-bottom: .55rem; line-height: 1.6; font-size: .95rem; }
			.amap-verdict li:last-child { margin-bottom: 0; }

			@media (max-width: 860px) {
				.amap-intents, .amap-engines { grid-template-columns: repeat(2, 1fr); }
			}
			@media (max-width: 640px) {
				.amap { padding: 2rem 1rem; border-radius: 14px; margin-left: -.5rem; margin-right: -.5rem; }
				.amap-head h2 { font-size: 1.3rem; }
				.amap-tier { padding: 1.1rem 1rem; }
				.amap-sources { grid-template-columns: 1fr; }
			}
		</style>
	</body>
</html>
