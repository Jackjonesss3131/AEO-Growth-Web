---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

export const prerender = true;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`What an AI sees on your site — ${SITE_TITLE}`}
			description="Check if ChatGPT, Claude, Perplexity and Google can read your site, and what they find when they crawl it."
		/>
	</head>
	<body>
		<Header />

		<main>
			<section class="prose">
				<p class="eyebrow">AI Crawler Checker</p>
				<h1>What an AI sees when it crawls your site</h1>
				<p class="lead">
					Paste a URL. We check your rules, crawl the page as each bot would, and tell you
					what they find and what's stopping them from citing you.
				</p>

				<form id="check-form" class="tool-form" method="get">
					<label for="check-url" class="sr-only">URL to analyze</label>
					<input
						id="check-url"
						name="url"
						type="text"
						inputmode="url"
						enterkeyhint="go"
						autocomplete="url"
						autocapitalize="off"
						spellcheck="false"
						placeholder="yourdomain.com or a specific page"
						required
					/>
					<button type="submit" class="btn-primary">Analyze</button>
				</form>
				<p id="check-status" class="tool-hint" role="status">Takes between 5 and 20 seconds.</p>

				<div id="check-results"></div>
			</section>
		</main>

		<Footer />

		<script>
			type Level = 'alto' | 'medio' | 'bajo' | 'info';
			type Finding = { level: Level; area: string; title: string; detail: string; fix: string };
			type Bot = {
				name: string;
				company: string;
				type: string;
				product: string;
				note: string;
				token: boolean;
				robots: { allowed: boolean; rule: string | null; src: string; delay?: string | null };
				live: { blocked: boolean; note: string } | null;
			};
			type Entity = { type: string; name: string; missing: string[]; sameAs?: string[]; questions?: number };
			type Sample = {
				url: string;
				path: string;
				status: number | null;
				note?: string;
				redirected?: boolean;
				title?: string;
				words: number;
				noindex: boolean;
				blockedFor: string[];
				types: string[];
			};
			type Report = {
				finalUrl: string;
				viewAs: string;
				ms: number;
				counts: Record<Level, number>;
				findings: Finding[];
				good: string[];
				bots: Bot[];
				page: {
					schema: { blocks: number; broken: number; microdata: boolean; types: string[]; entities: Entity[] };
				} | null;
				sitemap: {
					found: boolean;
					url?: string;
					inRobots?: boolean;
					children?: number;
					count: number;
					withLastmod: number;
					newest?: string | null;
					sameDate?: boolean;
				};
				freshness: { date: string; days: number; source: string } | null;
				samples: Sample[];
			};

			const ICONS: Record<Level, string> = { alto: '🔴', medio: '🟡', bajo: '🟠', info: '🔵' };
			const LABELS: Record<Level, string> = { alto: 'Critical', medio: 'Review', bajo: 'Minor', info: 'Info' };
			const ORDER: Level[] = ['alto', 'medio', 'bajo', 'info'];
			const TYPES: Record<string, string> = {
				entrenamiento: 'Training',
				busqueda: 'Search',
				usuario: 'User Visit',
			};

			const form = document.getElementById('check-form') as HTMLFormElement;
			const input = document.getElementById('check-url') as HTMLInputElement;
			const button = form.querySelector('button') as HTMLButtonElement;
			const statusLine = document.getElementById('check-status') as HTMLElement;
			const results = document.getElementById('check-results') as HTMLElement;
			const idleText = statusLine.textContent ?? '';

			const esc = (value: unknown) => String(value ?? '').replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
			const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
			const joinList = (parts: string[]) => new Intl.ListFormat('en', { type: 'conjunction' }).format(parts);
			const fmtDate = (iso: string) =>
				new Date(iso).toLocaleDateString('en', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
			const hint = (text: string) => `<span class="tool-hint">${esc(text)}</span>`;

			const queryFor = (url: string) =>
				'?url=' + encodeURIComponent(url).replace(/%3A/gi, ':').replace(/%2F/gi, '/');
			const urlFromLocation = () => (new URLSearchParams(location.search).get('url') ?? '').trim();

			function renderFindings(d: Report) {
				const sorted = [...d.findings].sort((a, b) => ORDER.indexOf(a.level) - ORDER.indexOf(b.level));

				const allRows = [
					...sorted.map(f => `
						<tr>
							<td>${ICONS[f.level]} <strong>${esc(LABELS[f.level])}</strong></td>
							<td>${esc(f.area)}</td>
							<td>${esc(f.title)}</td>
							<td>${esc(f.fix)}</td>
						</tr>`),
					...d.good.map(g => `
						<tr>
							<td>✅ <strong>Good</strong></td>
							<td>—</td>
							<td colspan="2">${esc(g)}</td>
						</tr>`),
				].join('');

				return `
					<h2>Summary</h2>
					<table>
						<thead>
							<tr>
								<th>Status</th>
								<th>Area</th>
								<th>What's happening</th>
								<th>What to do</th>
							</tr>
						</thead>
						<tbody>${allRows}</tbody>
					</table>`;
			}

			function renderBots(d: Report) {
				const rows = d.bots
					.map((b) => {
						const r = b.robots;
						const rule = (r.rule ? `${r.rule} (${r.src})` : r.src) + (r.delay ? `, Crawl-delay: ${r.delay}` : '');
						const robots = `robots.txt: ${r.allowed ? 'Allowed' : '<strong>Blocked</strong>'} ${hint('· ' + rule)}`;

						let live: string;
						if (b.token) live = `Live visit: ${hint('n/a, this is a robots.txt-only rule')}`;
						else if (!b.live) live = `Live visit: ${hint('not tested')}`;
						else live = `Live visit: ${b.live.blocked ? '<strong>Blocked</strong>' : 'Passes'} ${hint('· ' + b.live.note)}`;

						const about = [b.company, TYPES[b.type] ?? b.type, b.product || b.note].filter(Boolean).join(' · ');
						return `<tr><td><strong>${esc(b.name)}</strong><br>${hint(about)}</td><td>${robots}<br>${live}</td></tr>`;
					})
					.join('');

				return `
					<h2>Who can access</h2>
					<p class="tool-hint">robots.txt reflects your declared rules. Live visit is what happened when we requested the page identifying ourselves as each bot.</p>
					<table>
						<thead><tr><th>Bot</th><th>Status</th></tr></thead>
						<tbody>${rows}</tbody>
					</table>`;
			}

			function renderSchema(d: Report) {
				const title = '<h2>Structured Data</h2>';
				if (!d.page) return `${title}<p>We couldn't read the page.</p>`;

				const s = d.page.schema;
				if (!s.blocks && !s.microdata) return `${title}<p>This page has no structured data.</p>`;

				const found = [
					s.blocks ? plural(s.blocks, 'JSON-LD block', 'JSON-LD blocks') : '',
					s.microdata ? 'microdata' : '',
				].filter(Boolean);
				let line = joinList(found);
				line = line.charAt(0).toUpperCase() + line.slice(1);
				if (s.broken) line += ` (${s.broken} with syntax errors)`;
				if (s.types.length) line += `. Types: ${s.types.join(', ')}`;

				const entities = s.entities
					.map((e) => {
						const facts: string[] = [];
						if (e.sameAs) facts.push(`sameAs: ${e.sameAs.length}`);
						if (e.questions != null) facts.push(plural(e.questions, 'question', 'questions'));
						facts.push(e.missing.length ? `missing: ${e.missing.join(', ')}` : 'complete');
						return `<li><strong>${esc(e.type)}</strong>${e.name ? ` "${esc(e.name)}"` : ''} · ${esc(facts.join(' · '))}</li>`;
					})
					.join('');

				return `${title}<p>${esc(line)}.</p>${entities ? `<ul>${entities}</ul>` : ''}`;
			}

			function renderSitemap(d: Report) {
				const sm = d.sitemap;
				const title = '<h2>Sitemap</h2>';
				if (!sm.found) {
					return `${title}<p>No sitemap found: not in robots.txt, /sitemap-index.xml, or /sitemap.xml.</p>`;
				}

				const index = sm.children ? `, index with ${plural(sm.children, 'sitemap', 'sitemaps')}` : '';
				const partial = sm.children && sm.children > 5 ? ' (counting the first 5 sitemaps)' : '';
				const newest = sm.newest ? `; newest: ${fmtDate(sm.newest)}` : '';
				const facts = [
					`${plural(sm.count, 'URL', 'URLs')}${partial}, ${sm.withLastmod} with a date (lastmod)${newest}.`,
					sm.inRobots ? 'Declared in robots.txt.' : 'Not declared in robots.txt.',
				];
				if (sm.sameDate) facts.push('All URLs share the same date.');

				return `${title}<p><code>${esc(sm.url)}</code>${esc(index)}.</p><ul>${facts.map((f) => `<li>${esc(f)}</li>`).join('')}</ul>`;
			}

			function renderDates(d: Report) {
				const f = d.freshness;
				const text = f
					? `The most recent machine-readable date is ${fmtDate(f.date)} (${f.days ? `${plural(f.days, 'day', 'days')} ago` : 'today'}), found in ${f.source}.`
					: 'No machine-readable date found: not in schema, meta tags, or sitemap.';
				return `<h2>Dates</h2><p>${esc(text)}</p>`;
			}

			function renderSamples(d: Report) {
				const title = '<h2>Internal Pages</h2>';
				if (!d.samples.length) return `${title}<p>No other URLs from this domain found in the sitemap.</p>`;

				const items = d.samples
					.map((s) => {
						const ok = s.status != null && s.status >= 200 && s.status < 300;
						const facts = [s.status ? `HTTP ${s.status}` : s.note || 'no response'];
						if (ok) facts.push(plural(s.words, 'word', 'words'));
						if (s.redirected) facts.push('redirects');
						if (s.noindex) facts.push('noindex');
						if (s.blockedFor.length) facts.push(`blocked for ${s.blockedFor.join(', ')}`);
						if (s.types.length) facts.push(s.types.join(', '));
						return `<li><a href="${esc(queryFor(s.url))}" data-url="${esc(s.url)}">${esc(s.path)}</a>${s.title ? ` — ${esc(s.title)}` : ''}<br>${hint(facts.join(' · '))}</li>`;
					})
					.join('');

				return `${title}<p>URLs from your sitemap. Click one to analyze it.</p><ul>${items}</ul>`;
			}

			const NOTE =
				'<p class="tool-hint">We request the page from a server — once as a browser and once as each bot — and compare. Real bots come from their own IPs, so an IP-checking firewall may treat them differently. Results cached for 15 min.</p>';

			const render = (d: Report) =>
				[renderFindings, renderBots, renderSchema, renderSitemap, renderDates, renderSamples]
					.map((section) => section(d))
					.join('') + NOTE;

			let current: AbortController | null = null;

			async function analyze(url: string) {
				current?.abort();
				const run = (current = new AbortController());

				input.value = url;
				button.disabled = true;
				results.innerHTML = '';
				statusLine.textContent = `Analyzing ${url}…`;

				try {
					const res = await fetch('/api/check-crawlers?url=' + encodeURIComponent(url), { signal: run.signal });
					const data = await res.json().catch(() => null);
					if (run !== current) return;

					if (!res.ok || !data || data.error) {
						statusLine.textContent = data?.error || 'Something went wrong. Please try again.';
						return;
					}

					const report = data as Report;
					statusLine.textContent = `${report.finalUrl} · read as ${report.viewAs} · ${(report.ms / 1000).toFixed(1)} s`;
					results.innerHTML = render(report);
				} catch {
					if (run.signal.aborted) return;
					statusLine.textContent =
						'We couldn\'t complete the analysis. The site may be too slow to respond; try again.';
				} finally {
					if (run === current) button.disabled = false;
				}
			}

			function go(url: string) {
				if (urlFromLocation() !== url) history.pushState(null, '', queryFor(url));
				analyze(url);
			}

			form.addEventListener('submit', (event) => {
				event.preventDefault();
				const url = input.value.trim();
				if (url) go(url);
			});

			results.addEventListener('click', (event) => {
				const link = (event.target as Element).closest<HTMLAnchorElement>('a[data-url]');
				if (!link?.dataset.url) return;
				if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
				event.preventDefault();
				go(link.dataset.url);
				window.scrollTo({ top: 0 });
			});

			window.addEventListener('popstate', () => {
				const url = urlFromLocation();
				if (url) {
					analyze(url);
					return;
				}
				current?.abort();
				current = null;
				input.value = '';
				results.innerHTML = '';
				statusLine.textContent = idleText;
				button.disabled = false;
			});

			const initial = urlFromLocation();
			if (initial) analyze(initial);
		</script>
	</body>
</html>
