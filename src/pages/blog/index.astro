---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Blog — ${SITE_TITLE}`}
			description="Notes on how B2B SaaS companies get found, cited, and described in AI-generated answers."
		/>
	</head>
	<body>
		<Header />

		<main>
			<section class="blog-head">
				<p class="eyebrow">Blog</p>
				<h1>Notes from the messy end</h1>
				<p>
					What I find when I look at how AI systems actually describe B2B SaaS companies — and what
					it takes to change it.
				</p>
			</section>

			{posts.length === 0 ? (
				<p class="empty">No posts yet.</p>
			) : (
				<ul class="post-list">
					{posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								<p class="post-date"><FormattedDate date={post.data.pubDate} /></p>
								<h2 class="post-title">{post.data.title}</h2>
								<p class="post-desc">{post.data.description}</p>
							</a>
						</li>
					))}
				</ul>
			)}
		</main>

		<Footer />
	</body>
</html>
