---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE, CALENDLY_URL } from '../consts';

const stages = [
	{ n: 1, name: 'Retrieval', q: 'Does the model pull your content at all?' },
	{ n: 2, name: 'Citation', q: 'Does it use your content as a source?' },
	{ n: 3, name: 'Interpretation', q: 'Does it understand what your content says?' },
	{ n: 4, name: 'Expression', q: 'How does it describe your company in the final answer?', key: true },
];

const steps = [
	{
		n: '01',
		title: 'We see what AI says about you today',
		body: 'We write the questions your buyer asks before they know you exist — with their stack, team size and budget attached — and run them across ChatGPT, Perplexity, Gemini and Google\u2019s AI results.',
		outcome: 'You leave this step knowing whether you get recommended, how you are described, and who appears in your place.',
	},
	{
		n: '02',
		title: 'We fix what is describing you wrong',
		body: 'Your site says one thing, your G2 profile says another, a roundup from two years ago says a third. The model picks the version with the most sources behind it, and that is usually the oldest one.',
		outcome: 'You leave this step with one version of your company circulating across the web instead of three competing.',
	},
	{
		n: '03',
		title: 'We build the pages that decide the answer',
		body: 'Integration pages, honest comparisons, pricing with context, results by segment. The questions your buyer asks right before choosing — not the ones they ask while still learning the category.',
		outcome: 'You leave this step showing up when someone asks what to use, not only what something is.',
	},
	{
		n: '04',
		title: 'We measure every month and adjust',
		body: 'Engines change, competitors publish, and what worked three months ago stops working. We run the same question set across every engine and record what moved.',
		outcome: 'You leave every month knowing what changed and what caused it.',
	},
];

const includes = [
	{
		title: 'Content built for AI retrieval',
		body: 'Not articles that explain concepts. Pages built so a model uses them as the source when your buyer asks which tool to use.',
	},
	{
		title: 'Segment and market targeting',
		body: 'One page per segment and region you serve. When someone asks for a solution for their industry, size or country, you appear instead of a generic answer.',
	},
	{
		title: 'AEO across your entire site',
		body: 'Crawlability, structured data and architecture. Most AI crawlers do not execute JavaScript, so if they cannot read your pages, nothing downstream matters.',
	},
	{
		title: 'Correction of your identity across the web',
		body: 'Your G2 profile, directory listings and the comparison pages that include you. If they describe the company you were two years ago, the model repeats that version.',
	},
];

const benefits = [
	{ n: '1', title: 'Authority that holds', body: 'You stop depending on a traffic spike or an algorithm update. You build presence in the sources models consult every time someone asks about your category.' },
	{ n: '2', title: 'Presence in the niches you actually serve', body: 'You stop competing for the broad question where incumbents always win, and start winning the specific ones where your product is the better answer.' },
	{ n: '3', title: 'Recommendation, not just mention', body: 'Being named among ten options does not move pipeline. Being put forward as the option to consider does.' },
	{ n: '4', title: 'Leads that arrive already convinced', body: 'A buyer coming from an AI answer has already compared, already filtered and already decided you fit. The sales cycle shortens on its own.' },
	{ n: '5', title: 'Credibility from first contact', body: 'When a model describes your product correctly, the buyer arrives with no misconceptions to correct. In a market where nobody can tell who is serious, that is a signal.' },
	{ n: '6', title: 'Ground taken while competitors are not looking', body: 'Most companies in your category still do not measure this. The ones who start now take the position before it fills up.' },
];

const faqs = [
	{
		q: 'What is answer engine optimization (AEO)?',
		a: 'Answer engine optimization is the practice of making your company the answer when a buyer asks an AI engine a question \u2014 being retrieved, cited, understood, and described correctly. It differs from SEO, which measures whether you rank on a page of links.',
	},
	{
		q: 'How do you get recommended by ChatGPT?',
		a: 'Make sure AI crawlers can read your pages without JavaScript, keep one consistent description of your company across every source, publish pages that answer constrained buyer questions, and earn mentions on pages you do not control. Then measure what the models actually say, per engine, every month.',
	},
	{
		q: 'Is being cited by AI the same as being recommended?',
		a: 'No. A citation means a model used your page as a source. A recommendation means it named your product as an option worth evaluating. Many B2B SaaS companies have the first without the second.',
	},
	{
		q: 'Who is this for?',
		a: 'B2B SaaS companies that have repositioned in the last two years, compete against incumbents on broad category questions, or appear in AI answers with outdated or inaccurate descriptions.',
	},
	{
		q: 'How long does AEO take to work?',
		a: 'Changes to your own site register soonest in engines that search the web on every question. Changes to how third parties describe you take longer, because they depend on other sites being updated and re-crawled. Anyone promising a date for a specific engine is guessing.',
	},
];

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map((f) => ({
		'@type': 'Question',
		name: f.q,
		acceptedAnswer: { '@type': 'Answer', text: f.a },
	})),
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
	</head>
	<body>
		<Header />

		<main>
			<section class="hero">
				<p class="eyebrow">AEO &amp; GEO for B2B SaaS</p>
				<h1>Being cited isn't the same as being understood.</h1>
				<p class="hero-sub">
					Most tools tell you whether your brand appeared in an AI answer. That's a yes or no, and it
					misses where the real failures are. I look at what the model actually says about you — and
					whether it matches what you sell today.
				</p>
				<div class="hero-cta">
					<a href={CALENDLY_URL} target="_blank" rel="noopener" class="btn-primary">Get a free audit</a>
					<a href="/services" class="btn-ghost">See how it works</a>
				</div>
			</section>

			<section class="framework">
				<div class="stages">
					{stages.map((s) => (
						<div class:list={['stage', { 'is-key': s.key }]}>
							<span class="stage-n">{s.n}</span>
							<div>
								<h3>{s.name}</h3>
								<p>{s.q}</p>
							</div>
						</div>
					))}
				</div>
				<p class="framework-note">
					Most audits measure the first two. The interesting failures live in the fourth — companies
					cited accurately, in the category they've already moved away from.
				</p>
			</section>

			<section class="offer">
				<div class="section-head">
					<p class="eyebrow">The process</p>
					<h2>How we get AI to recommend you</h2>
					<p>
						Each step builds on the last. Content published on top of an unresolved entity doesn't
						compound — it gets attributed to whichever record the model settled on.
					</p>
				</div>

				<div class="phases">
					{steps.map((s) => (
						<article class="phase">
							<div class="phase-n">{s.n}</div>
							<div>
								<h3>{s.title}</h3>
								<p class="phase-desc">{s.body}</p>
								<p class="phase-outcome">{s.outcome}</p>
							</div>
						</article>
					))}
				</div>
			</section>

			<section class="includes-section">
				<div class="section-head">
					<p class="eyebrow">What's included</p>
					<h2>The work itself</h2>
				</div>
				<div class="includes">
					{includes.map((i) => (
						<article class="include">
							<h3>{i.title}</h3>
							<p>{i.body}</p>
						</article>
					))}
				</div>
			</section>

			<section class="gains">
				<div class="section-head">
					<p class="eyebrow">What you gain</p>
					<h2>What this changes for your business</h2>
					<p>Visibility on its own is a vanity metric. These are the outcomes worth paying for.</p>
				</div>
				<ol class="gain-list">
					{benefits.map((b) => (
						<li class="gain">
							<span class="gain-n">{b.n}</span>
							<div>
								<h3>{b.title}</h3>
								<p>{b.body}</p>
							</div>
						</li>
					))}
				</ol>
			</section>

			<section class="faq-section">
				<div class="section-head">
					<p class="eyebrow">Common questions</p>
					<h2>Short answers</h2>
				</div>
				<div class="faq">
					{faqs.map((f) => (
						<div class="faq-item">
							<h3>{f.q}</h3>
							<p>{f.a}</p>
						</div>
					))}
				</div>
			</section>

			<section class="close-cta">
				<h2>AI doesn't cite everyone.</h2>
				<p>
					Being mentioned isn't the same as being recommended. The difference is whether the model
					names you among several or puts you forward as the option to consider. Send me your domain
					and I'll tell you what the models say about you right now — free, before we ever talk.
				</p>
				<a href={CALENDLY_URL} target="_blank" rel="noopener" class="btn-primary">Get a free audit</a>
			</section>
		</main>

		<Footer />
	</body>
</html>
