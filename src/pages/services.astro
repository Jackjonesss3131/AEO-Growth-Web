---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { CALENDLY_URL } from '../consts';

export const prerender = true;

const phases = [
	{
		n: '01',
		title: 'The audit',
		lead: 'What the engines say about you, and where they got it. Free.',
		body: 'I run the questions your buyers ask — with their real constraints attached — across ChatGPT, Perplexity, Gemini and Google\'s AI results. Three things come out of it. Who your actual competitors are in those answers, which is often not the company you think you\'re up against. Where the information describing you is coming from, including the sources saying something you\'d rather they didn\'t. And whether what the models say you sell matches what you actually sell.',
		deliverable: 'The questions I ran, what each engine answered, who appeared in your place, and the cause. Short enough to read in one sitting. Yours to keep, including if you take it to someone else.',
		tags: ['Free', 'Real competitor set', 'Source mapping', 'Description accuracy'],
	},
	{
		n: '02',
		title: 'The fix',
		lead: 'What\'s broken, what solves it, and the work itself.',
		body: 'The findings turn into a specific list: this is failing, this is why, this is what resolves it. Crawler access and schema where the site isn\'t legible. Corrected listings and profiles where the web disagrees with you. The pages your buyers\' constrained questions require — integrations, comparisons, "best for", alternatives. One consistent record of what your company is, instead of three competing ones.',
		deliverable: 'The plan within five business days, then the corrections shipped.',
		tags: ['Crawler access', 'Schema markup', 'Listing corrections', 'Buyer-intent pages'],
	},
	{
		n: '03',
		title: 'Measurement',
		lead: 'Whether the engines picked it up.',
		body: 'The same questions, rerun per engine. Not a visibility score — the things that decide whether this was worth doing: are you recommended or only mentioned, where you sit in the shortlist, whether the description is now accurate, which of the new sources the engines are actually citing, and who still takes your place when you\'re absent.',
		deliverable: 'A monthly report tying each change in the answers back to a specific source and a specific piece of work.',
		tags: ['Per-engine tracking', 'Citation sources', 'Description accuracy'],
	},
	{
		n: '04',
		title: 'Adjust',
		lead: 'Once the models have real context, go after what\'s left.',
		body: 'By this point the engines have a correct picture of what you sell and who you sell it to. That changes which questions are winnable. Some answers move with one more source; others need a page that doesn\'t exist yet. The same loop runs again, aimed at the questions still going to someone else — because engines re-weight, competitors publish, and what worked in March stops working.',
		deliverable: 'An updated priority list each cycle, built from what moved and what didn\'t.',
		tags: ['Gap analysis', 'New questions', 'Ongoing correction'],
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="AEO Services for B2B SaaS — AEO Growth"
			description="Answer engine optimization and GEO for B2B SaaS. Diagnosis, corrections, and monthly measurement of what AI engines say about your company — starting with an audit."
		/>
	</head>
	<body>
		<Header />

		<main>
			<section class="hero">
				<p class="eyebrow">Services</p>
				<h1>AEO for B2B SaaS, starting with the diagnosis.</h1>
				<p class="hero-sub">
					I help B2B software companies get recommended — and described correctly — when buyers ask
					AI engines what to use. Every engagement starts with an audit, so you see the findings
					before committing to anything longer.
				</p>
				<div class="hero-cta">
					<a href={CALENDLY_URL} target="_blank" rel="noopener" class="btn-primary">Book a call</a>
					<a href="/blog/what-is-an-ai-visibility-audit/" class="btn-ghost">What the audit covers</a>
				</div>
			</section>

			<section class="framework">
				<div class="stages">
					<div class="stage">
						<span class="stage-n">1</span>
						<div>
							<h3>Retrieval</h3>
							<p>Can the engine reach and read your pages at all?</p>
						</div>
					</div>
					<div class="stage">
						<span class="stage-n">2</span>
						<div>
							<h3>Citation</h3>
							<p>It can use your content as a source and still name someone else.</p>
						</div>
					</div>
					<div class="stage">
						<span class="stage-n">3</span>
						<div>
							<h3>Interpretation</h3>
							<p>Does it understand what you sell today, or what you sold two years ago?</p>
						</div>
					</div>
					<div class="stage is-key">
						<span class="stage-n">4</span>
						<div>
							<h3>Expression</h3>
							<p>What it answers when your buyer asks the question that ends in a purchase.</p>
						</div>
					</div>
				</div>
				<p class="framework-note">
					Most tools measure the first two and report a mention rate. The failures that cost pipeline
					live in the last two — a model that reads your page, takes a fact from it, recommends a
					competitor, and describes you as the company you stopped being. Everything below is built
					around measuring and fixing that.
				</p>
			</section>

			<section class="prose">
				<h2>Who this is for</h2>
				<p>Roughly in order of how often it turns out to be the problem:</p>
				<ul>
					<li>
						<strong>You compete against companies much larger than you</strong> and don't know how to
						stand out in an answer that only names three.
					</li>
					<li>
						<strong>You don't appear in AI answers and competitors at your level do.</strong> Sometimes
						the cause is as basic as the crawlers not being able to read your site — you can check
						that yourself in two minutes with the <a href="/ai-crawler-check/">Crawler Check</a>.
					</li>
					<li>
						<strong>You appear, but what the model says about you isn't what you'd say.</strong> Vague,
						outdated, or aimed at a buyer you don't sell to.
					</li>
					<li>
						<strong>Buyers pick a competitor who offers what you offer.</strong> Same capability, same
						price band, and the model keeps naming them.
					</li>
					<li>
						<strong>You repositioned or renamed in the last two years</strong> and the old description is
						still circulating. The <a href="/positioning-check/">Positioning Check</a> shows which
						version of your homepage the recent crawls captured.
					</li>
					<li>
						<strong>Your category's buyer's guides were written by your competitors</strong>, which is
						most B2B categories.
					</li>
				</ul>

				<h2>Who this isn't for</h2>
				<p>
					<strong>Pre-product companies.</strong> There's no point optimizing how you're described
					before there's something to describe.
				</p>
			</section>

			<section class="offer">
				<div class="section-head">
					<h2>Four phases, in order</h2>
				</div>

				<div class="phases">
					{phases.map((p) => (
						<article class="phase">
							<div class="phase-n">{p.n}</div>
							<div>
								<h3>{p.title}</h3>
								<p class="phase-lead">{p.lead}</p>
								<p class="phase-desc">{p.body}</p>
								<p class="phase-desc"><strong>You get:</strong> {p.deliverable}</p>
								<ul class="tags">
									{p.tags.map((t) => <li>{t}</li>)}
								</ul>
							</div>
						</article>
					))}
				</div>
			</section>

			<section class="prose">
				<h2>What the first 90 days look like</h2>
				<table>
					<thead>
						<tr><th>Period</th><th>What happens</th></tr>
					</thead>
					<tbody>
						<tr>
							<td><strong>Days 1–30</strong></td>
							<td>The audit, then the plan within five business days of it. Baseline across every engine, the sources describing you inventoried against how you describe yourself today, and a prioritized list of corrections.</td>
						</tr>
						<tr>
							<td><strong>Days 31–60</strong></td>
							<td>Corrections shipped: crawler access, schema, listings and profiles, and the pages your buyers' constrained questions require. First re-measurement on the same questions.</td>
						</tr>
						<tr>
							<td><strong>Days 61–90</strong></td>
							<td>Movement on engines that search the web on every question, where your own pages carry the most weight. Third-party corrections underway but not fully reflected yet — that part is slower, because it depends on other sites updating and being re-crawled.</td>
						</tr>
					</tbody>
				</table>
				<p>
					What you shouldn't expect is a number for a board deck by day 30. What you should expect is
					knowing, by day 30, exactly why you're missing from the answers that matter.
				</p>

				<h2>Pricing</h2>
				<p>
					<strong>The audit is free.</strong> I'd rather show you what the engines say about your
					company than argue about whether this matters. You keep the findings either way, including
					if you hand them to your own team or take them to another vendor.
				</p>
				<p>
					I run <strong>five a month</strong>. Each one is real work on a real domain, not a generated
					report, so that's the honest limit.
				</p>
				<p>
					The work that follows starts at <strong>$1,000</strong> and gets scoped from the findings,
					because it varies enormously depending on how much outdated information is circulating about
					you and how much of it sits on sites you don't control. Quoting before the audit would be a
					rate card, not a proposal.
				</p>
				<p>
					Ongoing measurement runs <strong>$500 per month</strong> — the same questions, every engine,
					with each change traced back to the source that caused it.
				</p>
				<p>
					For what this work costs across the market, including the floor below which you're usually
					buying relabelled SEO, I wrote up the published numbers in
					<a href="/blog/how-to-choose-an-aeo-agency/">How to Choose an AEO Agency</a>. That post also
					has the questions I'd ask any vendor in this category, including me.
				</p>

				<h2>Common questions</h2>

				<h3>How is this different from SEO?</h3>
				<p>
					SEO gets your pages retrieved. It measures whether you rank. AEO measures whether the model
					chooses you and what it says about you. Both matter, and one depends on the other — covered
					in <a href="/blog/aeo-vs-seo-blog/">AEO vs SEO</a>.
				</p>

				<h3>Do I need this if I already use an AI visibility tool?</h3>
				<p>
					A tool monitors; it tells you a number changed. This diagnoses; it tells you why and which
					page to change. If your positioning is already clean and consistent and you have a team that
					can act on findings, a tool may be enough on its own.
				</p>

				<h3>Which engines do you cover?</h3>
				<p>
					ChatGPT, Perplexity, Gemini and Google's AI results, tracked separately. They draw from
					different sources and frequently disagree, which is why a single "AI visibility" number
					hides more than it shows.
				</p>

				<h3>How long until it works?</h3>
				<p>
					Changes to your own site register soonest in engines that search the web on every question.
					Changes to how third parties describe you take longer, because they depend on other sites
					being updated and re-crawled. Anyone promising a date for a specific engine is guessing.
				</p>

				<h3>What do you need from us?</h3>
				<p>
					For the audit, just your domain and what you sell. Nothing else — no call, no access, no
					form filled in triplicate. For the work after it, access to your site and someone who can
					approve changes to listings and profiles.
				</p>

				<h3>Why is the audit free?</h3>
				<p>
					Because I'm new at this and you have no reason to take my word for anything. Showing you
					what the engines say about your company is faster than convincing you it matters. If the
					findings are useful and you want help acting on them, we'll talk. If they're useful and you
					act on them yourself, that's a fine outcome too.
				</p>

				<h3>Can my SEO agency do this instead?</h3>
				<p>
					They can handle the technical layer and some of the pages, because it resembles work they
					already do. Correcting how third parties describe you usually isn't in their scope. Ask them
					what they measure and how they verify the description is accurate — the answer tells you
					which you're dealing with.
				</p>
			</section>

			<section class="tools">
				<div class="section-head">
					<p class="eyebrow">Free tools</p>
					<h2>Not sure where you're stuck?</h2>
					<p>Both run on your own domain. No signup, no call, under a minute each.</p>
				</div>

				<div class="tool-grid">
					<a href="/ai-crawler-check/" class="tool-card">
						<span class="tool-badge">2 minutes</span>
						<h3>Crawler Check</h3>
						<p class="tool-desc">
							See exactly what each AI bot receives when it visits your site. Most crawlers don't
							run JavaScript — if yours comes back empty, nothing else you publish matters until
							that's fixed.
						</p>
						<span class="tool-link">Run the check<span aria-hidden="true"> →</span></span>
					</a>

					<a href="/positioning-check/" class="tool-card">
						<span class="tool-badge">40 seconds</span>
						<h3>Positioning Check</h3>
						<p class="tool-desc">
							See how your homepage described you over the last three years, and which version the
							recent crawls captured. If the snapshot on record isn't the company you sell today,
							that's what the models learned.
						</p>
						<span class="tool-link">Check your positioning<span aria-hidden="true"> →</span></span>
					</a>
				</div>
			</section>

			<section class="close-cta">
				<h2>Start with the findings</h2>
				<p>
					Send me your domain and what you sell. I'll run your buyers' questions across every engine
					and send back what they say about you — whether you're recommended, how you're described,
					and who appears in your place. No call required to get it. Five a month.
				</p>
				<a href={CALENDLY_URL} target="_blank" rel="noopener" class="btn-primary">Request the audit</a>
			</section>
		</main>

		<Footer />

		<style>
			.tools {
				margin: 4rem 0;
			}

			.tool-grid {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 1.25rem;
				margin-top: 2rem;
			}

			.tool-card {
				display: flex;
				flex-direction: column;
				align-items: flex-start;
				padding: 1.75rem;
				border: 1px solid rgba(0, 0, 0, 0.1);
				border-radius: 14px;
				background: #fff;
				text-decoration: none;
				color: inherit;
				transition:
					transform 0.18s ease,
					box-shadow 0.18s ease,
					border-color 0.18s ease;
			}

			.tool-card:hover {
				transform: translateY(-3px);
				border-color: rgba(37, 99, 235, 0.45);
				box-shadow: 0 10px 28px rgba(15, 23, 42, 0.09);
			}

			.tool-badge {
				display: inline-block;
				padding: 0.2rem 0.6rem;
				border-radius: 999px;
				background: rgba(37, 99, 235, 0.09);
				color: #2563eb;
				font-size: 0.72rem;
				font-weight: 600;
				letter-spacing: 0.04em;
				text-transform: uppercase;
			}

			.tool-card h3 {
				margin: 0.9rem 0 0.6rem;
				font-size: 1.3rem;
				line-height: 1.25;
			}

			.tool-desc {
				margin: 0 0 1.4rem;
				font-size: 0.95rem;
				line-height: 1.6;
				opacity: 0.78;
			}

			.tool-link {
				margin-top: auto;
				font-weight: 600;
				font-size: 0.95rem;
				color: #2563eb;
			}

			.tool-card:hover .tool-link span {
				display: inline-block;
				transform: translateX(3px);
				transition: transform 0.18s ease;
			}

			@media (max-width: 720px) {
				.tool-grid {
					grid-template-columns: 1fr;
				}
			}

			@media (prefers-color-scheme: dark) {
				.tool-card {
					background: rgba(255, 255, 255, 0.03);
					border-color: rgba(255, 255, 255, 0.12);
				}
				.tool-card:hover {
					border-color: rgba(96, 165, 250, 0.5);
					box-shadow: 0 10px 28px rgba(0, 0, 0, 0.35);
				}
			}
		</style>
	</body>
</html>
