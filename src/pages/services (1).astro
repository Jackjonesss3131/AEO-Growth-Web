---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { CALENDLY_URL } from '../consts';

const monthly = [
	{
		title: 'Measurement every two weeks',
		body: '25 buyer questions across ChatGPT, Perplexity, Gemini and Google. For each answer: recommended, mentioned or absent, the exact sentence describing you, and who showed up instead.',
	},
	{
		title: 'Entity inventory and corrections',
		body: 'Every listing, profile and comparison page that describes you, checked against what you sell today. The corrections get sent, not just flagged.',
	},
	{
		title: 'Outreach to the pages that decide the answer',
		body: 'The roundups and comparison pages in your category that take submissions or corrections. Five to ten every month.',
	},
	{
		title: 'Two pages a month',
		body: 'Integrations, honest comparisons, alternatives, pricing with context. The pages people read right before they decide.',
	},
	{
		title: 'Technical fixes',
		body: 'Crawler access, rendering, schema. Most AI crawlers don\u2019t run JavaScript. Done at the start, checked monthly.',
	},
];

const faqs = [
	{ q: 'How much does it cost?', a: '$2,000 a month. The audit before we start is free. Extra pages are $350 each, up to four a month. An additional market is $600 a month.' },
	{ q: 'Why only three clients?', a: 'Each one takes around 35 hours a month and I work alone. Three is what I can do properly. When the slots are full, they\u2019re full.' },
	{ q: 'What does the free audit include?', a: 'I run your buyer\u2019s questions across the major engines and tell you whether you get recommended, how you get described, and who appears instead. Yours to keep either way.' },
	{ q: 'Who is this for?', a: 'B2B SaaS between roughly $500K and $5M ARR. Agencies with a real methodology start at $3,500 a month and want companies above $5M. Below that there isn\u2019t much.' },
	{ q: 'How long until something moves?', a: 'Changes to your own site register soonest in engines that search the web on every question. Changes to how third parties describe you take longer. Anyone promising a date for a specific engine is guessing.' },
	{ q: 'Do you guarantee placement in ChatGPT?', a: 'No. Nobody controls these systems. Any vendor promising a specific position in a specific engine is selling you a guess.' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Services — AEO Growth"
			description="AEO for B2B SaaS under $5M ARR. Free audit, then $2,000 a month. Measurement every two weeks, entity corrections, outreach and content. Three clients at a time."
		/>
	</head>
	<body>
		<Header />

		<main>
			<section class="hero">
				<p class="eyebrow">Services</p>
				<h1>AEO for B2B SaaS that isn't big enough for the agencies yet.</h1>
				<p class="hero-sub">
					Agencies with a real methodology start at $3,500 a month and want companies above $5M ARR.
					Below that there's almost nothing. That's the gap I work in.
				</p>
				<div class="hero-cta">
					<a href={CALENDLY_URL} target="_blank" rel="noopener" class="btn-primary">Get a free audit</a>
					<a href="#pricing" class="btn-ghost">See pricing</a>
				</div>
			</section>

			<section class="framework">
				<div class="stages">
					<div class="stage"><span class="stage-n">1</span><div><h3>Retrieval</h3><p>Can the engine reach and read your pages?</p></div></div>
					<div class="stage"><span class="stage-n">2</span><div><h3>Citation</h3><p>Does it use your content as a source?</p></div></div>
					<div class="stage"><span class="stage-n">3</span><div><h3>Interpretation</h3><p>Does it understand what your content says?</p></div></div>
					<div class="stage is-key"><span class="stage-n">4</span><div><h3>Expression</h3><p>How does it describe your company in the answer?</p></div></div>
				</div>
				<p class="framework-note">
					Every agency in this category measures the first two and reports a mention rate. The failures
					that cost you deals live in the fourth.
				</p>
			</section>

			<section class="includes-section">
				<div class="section-head">
					<p class="eyebrow">The work</p>
					<h2>What happens every month</h2>
				</div>
				<div class="includes">
					{monthly.map((m) => (
						<article class="include">
							<h3>{m.title}</h3>
							<p>{m.body}</p>
						</article>
					))}
				</div>
			</section>

			<section class="pricing" id="pricing">
				<div class="section-head">
					<p class="eyebrow">Pricing</p>
					<h2>Published, so you don't need a call to find out</h2>
				</div>

				<div class="price-grid">
					<article class="price-card">
						<p class="price-label">To start</p>
						<p class="price-figure">Free</p>
						<p class="price-note">The audit. I run your buyer's questions across every engine and send you what I find. Yours to keep, even if you take it elsewhere.</p>
					</article>

					<article class="price-card is-main">
						<p class="price-label">Ongoing</p>
						<p class="price-figure">$2,000<span>/month</span></p>
						<p class="price-note">Everything above. Three months to start, month to month after that. Three clients at a time.</p>
					</article>
				</div>

				<table class="price-extras">
					<thead><tr><th>Extras</th><th>Price</th></tr></thead>
					<tbody>
						<tr><td>Additional page</td><td>$350 each, up to four a month</td></tr>
						<tr><td>Additional market</td><td>$600 a month</td></tr>
					</tbody>
				</table>
			</section>

			<section class="prose">
				<h2>Who this is for</h2>
				<ul>
					<li>You repositioned or renamed in the last two years</li>
					<li>Buyers mention finding a competitor through ChatGPT or Perplexity</li>
					<li>You're a specialist losing broad category questions to incumbents</li>
					<li>You appear in AI answers described vaguely, or as the company you used to be</li>
					<li>You run more than one domain</li>
				</ul>

				<h2>Who this isn't for</h2>
				<ul>
					<li><strong>Pre-product companies.</strong> There's nothing to describe yet.</li>
					<li><strong>Teams needing content at volume.</strong> Two pages a month is what one person does well. If you need fifty, buy an agency.</li>
					<li><strong>Anyone wanting guarantees.</strong> Nobody controls these engines.</li>
				</ul>

				<h2>The first 90 days</h2>
				<table>
					<thead><tr><th>Period</th><th>What happens</th></tr></thead>
					<tbody>
						<tr><td><strong>Days 1–30</strong></td><td>Baseline across every engine. Full entity inventory. A prioritized list of what's wrong and the order it gets fixed in.</td></tr>
						<tr><td><strong>Days 31–60</strong></td><td>Corrections shipped. Listings, schema, crawler access, first pages live. Outreach started. First re-measurement.</td></tr>
						<tr><td><strong>Days 61–90</strong></td><td>Movement on engines that search the web on every question. Outreach landing. A clear account of what changed and what caused it.</td></tr>
					</tbody>
				</table>
				<p>
					What you shouldn't expect is a clean number for a board deck by day 30. What you should
					expect is knowing, by day 30, exactly why you're missing from the answers that matter.
				</p>
			</section>

			<section class="faq-section">
				<div class="section-head">
					<p class="eyebrow">Common questions</p>
					<h2>Short answers</h2>
				</div>
				<div class="faq">
					{faqs.map((f) => (
						<div class="faq-item"><h3>{f.q}</h3><p>{f.a}</p></div>
					))}
				</div>
			</section>

			<section class="close-cta">
				<h2>Start with the audit.</h2>
				<p>
					Send me your domain. I'll tell you what the models say about you right now, who gets
					recommended instead, and which pages are causing it. Free, and yours either way.
				</p>
				<a href={CALENDLY_URL} target="_blank" rel="noopener" class="btn-primary">Get a free audit</a>
			</section>
		</main>

		<Footer />
	</body>
</html>
