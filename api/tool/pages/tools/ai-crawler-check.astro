---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { CALENDLY_URL } from '../../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Can AI read your site? — Free checker"
			description="Free tool. Check whether ChatGPT, Claude and Perplexity crawlers can actually reach and read your website. Tests crawler access, JavaScript dependency, robots.txt, schema and headers."
		/>
	</head>
	<body>
		<Header />

		<main>
			<section class="hero tool-hero">
				<p class="eyebrow">Free tool</p>
				<h1>Can AI crawlers actually read your site?</h1>
				<p class="hero-sub">
					Most AI crawlers don't run JavaScript, and plenty of sites block them without knowing.
					This checks both in about ten seconds. No email, no signup.
				</p>

				<form id="f" class="tool-form">
					<label class="sr-only" for="url">Your domain</label>
					<input
						id="url"
						name="url"
						type="text"
						inputmode="url"
						autocomplete="url"
						placeholder="yourcompany.com"
						required
					/>
					<button type="submit" class="btn-primary" id="go">Run the check</button>
				</form>
				<p class="tool-hint" id="hint">Checks GPTBot, ClaudeBot, PerplexityBot and five more.</p>
			</section>

			<section class="tool-out" id="out" hidden>
				<div class="section-head" id="outhead"></div>
				<div class="results" id="results"></div>

				<div class="tool-cta" id="tcta" hidden>
					<h3>This only covers whether they can read you.</h3>
					<p>
						It doesn't tell you what they say about you once they do. That's the audit — your
						buyer's questions run across every engine, with the exact descriptions coming back.
						Free, and yours to keep.
					</p>
					<a
						href={CALENDLY_URL}
						target="_blank"
						rel="noopener"
						class="btn-primary"
						id="auditcta"
					>Get a free audit</a>
				</div>
			</section>

			<section class="prose tool-explainer">
				<h2>What each check means</h2>

				<h3>Crawler access</h3>
				<p>
					Requests your homepage with an AI crawler's user agent and compares it against a normal
					browser. If your server answers one and refuses the other, something at your CDN or
					firewall is blocking them — and robots.txt won't tell you that.
				</p>

				<h3>Readable without JavaScript</h3>
				<p>
					Counts the words in the raw HTML your server returns, before any script runs. GPTBot,
					ClaudeBot and PerplexityBot fetch JavaScript files but don't execute them. A
					client-rendered site can rank fine on Google and be almost empty to them.
				</p>

				<h3>robots.txt</h3>
				<p>
					Resolves the rules for each AI crawler individually, including which group applies and
					whether a specific rule overrides the wildcard. Blocking the training crawler while
					allowing the live search fetcher is a reasonable choice. Blocking everything by accident
					is not.
				</p>

				<h3>Structured data</h3>
				<p>
					Parses your JSON-LD and reports what types are declared. It also catches blocks that
					don't parse, which fail silently and are easy to miss.
				</p>

				<h3>Headers and meta tags</h3>
				<p>
					Looks for X-Robots-Tag and robots meta directives that block indexing or AI use.
				</p>

				<h3>Sitemap</h3>
				<p>Follows the sitemap declared in robots.txt, or the usual paths, and counts the URLs in it.</p>
			</section>
		</main>

		<Footer />

		<script is:inline>
			const f = document.getElementById('f');
			const out = document.getElementById('out');
			const head = document.getElementById('outhead');
			const results = document.getElementById('results');
			const tcta = document.getElementById('tcta');
			const go = document.getElementById('go');
			const hint = document.getElementById('hint');

			const ICON = {
				pass: '<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 10.5l3.2 3.2L15 7" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/></svg>',
				warn: '<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 5.5v5.2" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round"/><circle cx="10" cy="14.4" r="1.15" fill="currentColor"/></svg>',
				fail: '<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M6.4 6.4l7.2 7.2M13.6 6.4l-7.2 7.2" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round"/></svg>',
			};
			const WORD = { pass: 'Pass', warn: 'Check', fail: 'Problem' };

			function esc(s) {
				return String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);
			}

			f.addEventListener('submit', async (e) => {
				e.preventDefault();
				const url = document.getElementById('url').value.trim();
				if (!url) return;

				if (window.gtag) {
					gtag('event', 'crawler_check_run', { domain: url.replace(/^https?:\/\//, '').replace(/\/$/, '') });
				}

				go.disabled = true;
				go.textContent = 'Checking…';
				hint.textContent = 'Fetching robots.txt, homepage and sitemap…';
				out.hidden = false;
				tcta.hidden = true;
				head.innerHTML = '';
				results.innerHTML = '<p class="tool-loading">Running six checks…</p>';

				try {
					const r = await fetch('/api/check?url=' + encodeURIComponent(url));
					const d = await r.json();

					if (d.error) {
						results.innerHTML = '<p class="tool-loading">' + esc(d.error) + '</p>';
						return;
					}
					if (d.unreachable) {
						head.innerHTML = '<h2>Couldn\'t reach ' + esc(d.base) + '</h2>';
						results.innerHTML = '<p class="tool-loading">' + esc(d.error || 'No response.') + '</p>';
						return;
					}

					const { fails, warns } = d.summary;
					const verdict =
						fails > 0
							? fails + ' problem' + (fails > 1 ? 's' : '') + ' found'
							: warns > 0
								? warns + ' thing' + (warns > 1 ? 's' : '') + ' worth checking'
								: 'Everything passes';

					head.innerHTML =
						'<p class="eyebrow">' + esc(d.base.replace(/^https?:\/\//, '')) + '</p><h2>' + verdict + '</h2>';

					results.innerHTML = d.checks
						.map((c) => {
							let botRows = '';
							if (c.bots && c.bots.length) {
								botRows =
									'<ul class="botlist">' +
									c.bots
										.map(
											(b) =>
												'<li class="bot is-' +
												(b.state === 'blocked' ? 'fail' : b.state === 'partial' ? 'warn' : 'pass') +
												'"><span>' +
												esc(b.name) +
												'</span><em>' +
												esc(b.state) +
												'</em></li>'
										)
										.join('') +
									'</ul>';
							}
							return (
								'<article class="rescard is-' + c.state + '">' +
								'<div class="resicon">' + ICON[c.state] + '</div>' +
								'<div class="resbody"><h3>' + esc(c.label) +
								'<span class="restag">' + WORD[c.state] + '</span></h3>' +
								'<p>' + esc(c.note) + '</p>' + botRows + '</div></article>'
							);
						})
						.join('');

					if (window.gtag) {
						gtag('event', 'crawler_check_result', {
							domain: d.base.replace(/^https?:\/\//, ''),
							problems: fails,
							warnings: warns,
							failed_checks: d.checks.filter((c) => c.state === 'fail').map((c) => c.id).join(',') || 'none',
						});
					}

					tcta.hidden = false;
				} catch (err) {
					results.innerHTML = '<p class="tool-loading">Something went wrong. Try again in a moment.</p>';
				} finally {
					go.disabled = false;
					go.textContent = 'Run the check';
					hint.textContent = 'Checks GPTBot, ClaudeBot, PerplexityBot and five more.';
				}
			});

			document.getElementById('auditcta')?.addEventListener('click', () => {
				if (window.gtag) {
					gtag('event', 'audit_cta_click', {
						source: 'crawler_check',
						domain: document.getElementById('url').value.trim(),
					});
				}
			});
		</script>
	</body>
</html>
